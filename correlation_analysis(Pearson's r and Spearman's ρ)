# 2. Build per-paper table: effect_size_count + Jaccard per field

# Note: Sutton et al. (2017) is excluded here (unlike in jaccard_analysis.R's
# Table 2, which keeps it) because surname-matching this paper pulls in rows
# from three different study_IDs (see Discussion / Limitations), which would
# distort its effect-size-row count. Development-set n is therefore 29 here,
# for a pooled n = 49 with the validation set -- matching Table 3.

build_per_paper <- function(ai_file, map, pkey, exclude_keys = character(0)) {
  ai <- read.csv(ai_file, stringsAsFactors = FALSE, check.names = FALSE)
  for (f in FIELDS) ai[[f]] <- norm(ai[[f]])
  ai$key <- vapply(ai$paper_id, pkey, character(1))

  map <- map[!(map$key %in% exclude_keys), , drop = FALSE]
  out <- data.frame(paper = map$key, effect_size_count = NA_integer_,
                     stringsAsFactors = FALSE)
  for (f in FIELDS) out[[paste0("jaccard_", f)]] <- NA_real_

  for (i in seq_len(nrow(map))) {
    hm <- hmatch(map$surname[i], map$year[i])
    am <- ai[!is.na(ai$key) & ai$key == map$key[i], , drop = FALSE]
    out$effect_size_count[i] <- nrow(hm)
    for (f in FIELDS) out[i, paste0("jaccard_", f)] <- jaccard(am[[f]], hm[[f]])
  }
  out
}

dev_per_paper <- build_per_paper(ai_dev_file, dev_map, pkey_dev, exclude_keys = "sutton")
val_per_paper <- build_per_paper(ai_val_file, val_map, pkey_val)

per_paper <- rbind(dev_per_paper, val_per_paper)
cat("Pooled n =", nrow(per_paper), "\n")
cat("effect_size_count range:", range(per_paper$effect_size_count),
    " mean:", round(mean(per_paper$effect_size_count), 1), "\n\n")

# ------------------------------------------------------------
# 3. Permutation-test correlation (Pearson's r AND Spearman's rho)
# ------------------------------------------------------------
# Significance is assessed by permutation (10,000 random reshuffles)
# rather than the standard parametric test for Pearson's r, because
# Jaccard similarity is bounded on [0, 1] and often takes boundary
# values, so its distribution may deviate from normality.

set.seed(42)

permutation_cor_test <- function(x, y, n_perm = 10000) {
  ok <- complete.cases(x, y)
  x <- x[ok]; y <- y[ok]

  obs_r   <- cor(x, y, method = "pearson")
  obs_rho <- cor(x, y, method = "spearman")

  perm_r   <- numeric(n_perm)
  perm_rho <- numeric(n_perm)
  for (i in seq_len(n_perm)) {
    y_perm <- sample(y)
    perm_r[i]   <- cor(x, y_perm, method = "pearson")
    perm_rho[i] <- cor(x, y_perm, method = "spearman")
  }

  data.frame(
    n = length(x),
    pearson_r = obs_r,
    pearson_p = mean(abs(perm_r) >= abs(obs_r)),
    spearman_rho = obs_rho,
    spearman_p = mean(abs(perm_rho) >= abs(obs_rho))
  )
}


# 4. Study complexity vs Jaccard, per moderator variable (Table 3)

complexity_results <- do.call(rbind, lapply(FIELDS, function(f) {
  res <- permutation_cor_test(per_paper$effect_size_count,
                               per_paper[[paste0("jaccard_", f)]])
  res$moderator_variable <- f
  res
}))
complexity_results <- complexity_results[, c("moderator_variable", "n", "pearson_r",
                                              "pearson_p", "spearman_rho", "spearman_p")]

cat("==== Study complexity vs Jaccard similarity ====\n")
print(round_df <- transform(complexity_results,
                             pearson_r = round(pearson_r, 3), pearson_p = round(pearson_p, 3),
                             spearman_rho = round(spearman_rho, 3), spearman_p = round(spearman_p, 3)))


# 5. Auxiliary-variable Jaccard vs core-variable Jaccard

per_paper$mean_jaccard_core <- rowMeans(per_paper[, paste0("jaccard_", CORE_FIELDS)], na.rm = TRUE)
per_paper$mean_jaccard_auxiliary <- rowMeans(per_paper[, paste0("jaccard_", AUX_FIELDS)], na.rm = TRUE)

aux_core_result <- permutation_cor_test(per_paper$mean_jaccard_auxiliary,
                                         per_paper$mean_jaccard_core)
cat("\n==== Auxiliary vs core variables ====\n")
print(round(aux_core_result, 3))


# 6. Paired permutation test -- control_type ablation experiment

# Requires a second extraction run with control_type_level_1/2 removed
# from the prompt (development set only, n = 29 after excluding Sutton).
# Plug in jaccard_kept / jaccard_removed (per-paper mean core-variable
# Jaccard under each condition, same paper order) once that re-extraction
# file is available.

paired_permutation_test <- function(jaccard_kept, jaccard_removed, n_perm = 10000) {
  diffs <- jaccard_kept - jaccard_removed
  obs_mean_diff <- mean(diffs)
  n <- length(diffs)
  perm_diffs <- numeric(n_perm)
  for (i in seq_len(n_perm)) {
    signs <- sample(c(-1, 1), size = n, replace = TRUE)
    perm_diffs[i] <- mean(diffs * signs)
  }
  data.frame(n = n, mean_difference = obs_mean_diff,
             permutation_p = mean(abs(perm_diffs) >= abs(obs_mean_diff)))
}

